# Streamlit Community Cloud: open your app > Manage app > Settings > Secrets, and paste this with YOUR values.
# (Locally you can also save it as .streamlit/secrets.toml, which is git-ignored, instead of using .env.)
# Each top-level key becomes an environment variable that the backend reads.

GROQ_API_KEY = "your_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"
DRY_RUN = "true"                      # keep "true": nothing is ever really sent

# Optional
# DEMO_COMPANY = "Hawthorn Road Family Dental Clinic"
# DEMO_URL = "https://familydentalclinic.com.au"
# DEMO_EMAIL = "you@example.com"
