# LOCAL use: copy this file to .env and fill it in.   (Windows: copy .env.example .env)
# STREAMLIT CLOUD: do NOT use a .env file; paste the same lines into  App settings > Secrets  (see .streamlit/secrets.toml.example).
# .env is git-ignored. Never put real keys or passwords in this example file.

LLM_PROVIDER=groq
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b          # default if unset: llama-3.3-70b-versatile
DATABASE_URL=sqlite:///./data/app.db

# true  = SAFE MODE: an approved email is only marked "sent (dry run)"; SMTP is never used.
# false = approved emails are REALLY sent (needs the SMTP_* lines below). Keep true on a public deployment.
DRY_RUN=true

# Only used when DRY_RUN=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password-here
# SMTP_FROM=you@example.com

# Optional: the example company filled in by the dashboard's "Load demo scenario" button
# DEMO_COMPANY=Hawthorn Road Family Dental Clinic
# DEMO_URL=https://familydentalclinic.com.au
# DEMO_EMAIL=you@example.com
